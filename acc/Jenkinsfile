pipeline {
    agent {
        label "cloud-focal"
    }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage("Setup pnpm") {
            steps {
              nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                sh "node -v"
                sh "npm -v"
                sh "pnpm -v || corepack enable pnpm"
                sh "pnpm install:all"
              }
            }
        }


        stage('Build feature') {
            when {
                branch pattern: "feature/*"
            }
            steps {
                nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                    sh "pnpm build"
                }
            }
        }


        stage("Build PR") {
            when {
                expression { env.CHANGE_ID != null } // It's a PR
            }
            steps {
                nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                    sh "pnpm build"
                }
            }
        }


        stage("Build dev") {
            when {
                anyOf {
                    branch pattern: "dev"
                }
            }
            environment {
                REACT_APP_API_MAX_PAGE_SIZE = "500"
                REACT_APP_API_ROOT = "https://api.devcloud.linode.com/v4"
