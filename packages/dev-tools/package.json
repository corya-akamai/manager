{
  "name": "@linode/dev-tools",
  "author": "Linode",
  "description": "Linode dev-tools library",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./__data__": "./src/__data__/index.ts"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/linode/manager/tree/develop/packages/ui"
  },
  "dependencies": {
    "@linode/api-v4": "workspace:*",
    "@linode/utilities": "workspace:*"
  },
  "scripts": {
    "start": "tsc -w --preserveWatchOutput",
    "lint": "eslint . --quiet --ext .js,.ts,.tsx",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint --ext .js,.ts,.tsx --quiet"
    ]
  },
  "devDependencies": {
    "@linode/tsconfig": "workspace:*"
  }
}
