{
  /**
   * This tsconfig makes tsc emit type declaration files.
   *
   * Currently, only api-v4 and validation emit types. All other packages don't have a build step.
   *
   * Note: When using this config, specify `outDir` in the comsuming tsconfig.
   */
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  }
}
